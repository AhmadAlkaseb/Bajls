@baseUrl = http://localhost:7070/api
@contentType = application/json
@adminAuth = Basic YWFuZGVyc2VuOlBAc3NBc3RhNQ==
@userAuth = Basic bWloYW5zZW46UEBzc01pYTE=
@ownerProfileId = 1
@seedHouseId = 1
@seedGarageId = 1
@unique = {{$timestamp}}

# JetBrains HTTP Client file.
# For create -> get/update/delete flows, copy the returned id from the POST response
# and replace the example ids below manually.

### Seed login as admin
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "username": "aandersen",
  "password": "P@ssAsta5"
}

### Seed login as user
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "username": "mihansen",
  "password": "P@ssMia1"
}

### Register a new user
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "firstName": "Route",
  "lastName": "Tester",
  "email": "route.tester.{{unique}}@example.com",
  "username": "routeuser{{unique}}",
  "password": "RoutePass123!",
  "role": "USER"
}

### Logout
POST {{baseUrl}}/auth/logout

### Get all profiles
GET {{baseUrl}}/profiles
Authorization: {{adminAuth}}

### Create profile
POST {{baseUrl}}/profiles
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "firstName": "Http",
  "lastName": "Profile",
  "email": "http.profile.{{unique}}@example.com",
  "username": "httpprofile{{unique}}",
  "password": "HttpPass123!",
  "role": "USER"
}

### Get own profile as authenticated user
GET {{baseUrl}}/profiles/{{ownerProfileId}}
Authorization: {{userAuth}}

### Update profile by id
PUT {{baseUrl}}/profiles/9991
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "id": 9991,
  "firstName": "HttpUpdated",
  "lastName": "Profile",
  "email": "http.profile.updated.manual@example.com",
  "username": "httpprofile_manual",
  "password": "HttpPass123!",
  "role": "USER"
}

### Delete profile by id
DELETE {{baseUrl}}/profiles/9991
Authorization: {{adminAuth}}

### Get all drugs
GET {{baseUrl}}/drugs
Authorization: {{adminAuth}}

### Get drug by id
GET {{baseUrl}}/drugs/1
Authorization: {{adminAuth}}

### Create drug
POST {{baseUrl}}/drugs
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "name": "Route Dust {{unique}}",
  "type": "METH"
}

### Update drug by id
PUT {{baseUrl}}/drugs/9992
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "id": 9992,
  "name": "Route Dust X Manual",
  "type": "COCAINE"
}

### Get all quests
GET {{baseUrl}}/quests
Authorization: {{adminAuth}}

### Get quest by id
GET {{baseUrl}}/quests/1
Authorization: {{adminAuth}}

### Create quest
POST {{baseUrl}}/quests
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "title": "HTTP Route Quest {{unique}}",
  "description": "Quest used for route verification.",
  "reward": 777.77
}

### Update quest by id
PUT {{baseUrl}}/quests/9993
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "id": 9993,
  "title": "HTTP Route Quest Updated Manual",
  "description": "Updated quest used for route verification.",
  "reward": 888.88
}

### Get all audit logs
GET {{baseUrl}}/audit-logs
Authorization: {{adminAuth}}

### Get audit log by seed id
GET {{baseUrl}}/audit-logs/1
Authorization: {{adminAuth}}

### Get all houses
GET {{baseUrl}}/houses
Authorization: {{userAuth}}

### Create standalone house
POST {{baseUrl}}/houses
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "amountRooms": 6,
  "amountBathrooms": 3
}

### Get standalone house by id
GET {{baseUrl}}/houses/{{seedHouseId}}
Authorization: {{userAuth}}

### Update house by id
PUT {{baseUrl}}/houses/9994
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": 9994,
  "amountRooms": 7,
  "amountBathrooms": 4
}

### Get all garages
GET {{baseUrl}}/garages
Authorization: {{userAuth}}

### Create standalone garage
POST {{baseUrl}}/garages
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "capacity": 6
}

### Get standalone garage by id
GET {{baseUrl}}/garages/{{seedGarageId}}
Authorization: {{userAuth}}

### Update garage by id
PUT {{baseUrl}}/garages/9995
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": 9995,
  "capacity": 8
}

### Get all characters
GET {{baseUrl}}/characters
Authorization: {{userAuth}}

### Create character
POST {{baseUrl}}/characters
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "name": "HttpRider {{unique}}",
  "balance": 1500.50,
  "profile": {
    "id": 1
  },
  "gender": "FEMALE",
  "skincolor": "LIGHT",
