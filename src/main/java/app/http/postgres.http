@baseUrl = http://localhost:7072/api
@contentType = application/json
@adminAuth = Basic YWFuZGVyc2VuOlBAc3NBc3RhNQ==
@userAuth = Basic bWloYW5zZW46UEBzc01pYTE=
@unique = {{$timestamp}}
@profileId = 1
@characterId = 1
@houseId = 1
@garageId = 1
@vehicleId = 1
@gangId = 1
@gangAffiliationId = 1
@drugId = 1
@questId = 1
@characterDrugId = 1
@characterQuestId = 1

# PostgreSQL sequential smoke flow.
# PostgreSQL app runs on port 7072.

### Admin login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "username": "aandersen",
  "password": "P@ssAsta5"
}

### User login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "username": "mihansen",
  "password": "P@ssMia1"
}

### List profiles
GET {{baseUrl}}/profiles
Authorization: {{adminAuth}}

### Create drug
POST {{baseUrl}}/drugs
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "name": "Route Dust {{unique}}",
  "type": "METH"
}

> {%
client.global.set("drugId", response.body.id);
%}

### Get created drug
GET {{baseUrl}}/drugs/{{drugId}}
Authorization: {{adminAuth}}

### Update created drug
PUT {{baseUrl}}/drugs/{{drugId}}
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "id": {{drugId}},
  "name": "Updated Dust {{unique}}",
  "type": "COCAINE"
}

### Create quest
POST {{baseUrl}}/quests
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "title": "HTTP Route Quest {{unique}}",
  "description": "Quest used for route verification.",
  "reward": 777.77
}

> {%
client.global.set("questId", response.body.id);
%}

### Get created quest
GET {{baseUrl}}/quests/{{questId}}
Authorization: {{adminAuth}}

### Update created quest
PUT {{baseUrl}}/quests/{{questId}}
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "id": {{questId}},
  "title": "Updated Quest {{unique}}",
  "description": "Updated description.",
  "reward": 888.88
}

### Create gang
POST {{baseUrl}}/gangs
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "name": "The Bajls {{unique}}",
  "type": "STREET"
}

> {%
client.global.set("gangId", response.body.id);
%}

### List gangs
GET {{baseUrl}}/gangs
Authorization: {{userAuth}}

### Get created gang
GET {{baseUrl}}/gangs/{{gangId}}
Authorization: {{userAuth}}

### Update created gang
PUT {{baseUrl}}/gangs/{{gangId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{gangId}},
  "name": "The Bajls Updated {{unique}}",
  "type": "MAFIA"
}

### Create character
POST {{baseUrl}}/characters
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "name": "HttpRider {{unique}}",
  "balance": 1500.50,
  "profile": { "id": {{profileId}} },
  "gender": "FEMALE",
  "skincolor": "LIGHT",
  "eyecolor": "GREEN",
  "height": "AVERAGE",
  "weight": "LIGHT",
  "house": {
    "amountRooms": 2,
    "amountBathrooms": 1
  },
  "garage": {
    "capacity": 2
  }
}

> {%
client.global.set("characterId", response.body.id);
client.global.set("houseId", response.body.house.id);
client.global.set("garageId", response.body.garage.id);
%}

### List characters
GET {{baseUrl}}/characters
Authorization: {{userAuth}}

### Get created character
GET {{baseUrl}}/characters/{{characterId}}
Authorization: {{userAuth}}

### List houses
GET {{baseUrl}}/houses
Authorization: {{userAuth}}

### Get linked house
GET {{baseUrl}}/houses/{{houseId}}
Authorization: {{userAuth}}

### Update linked house
PUT {{baseUrl}}/houses/{{houseId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{houseId}},
  "amountRooms": 4,
  "amountBathrooms": 3,
  "character": { "id": {{characterId}} }
}

### List garages
GET {{baseUrl}}/garages
Authorization: {{userAuth}}

### Get linked garage
GET {{baseUrl}}/garages/{{garageId}}
Authorization: {{userAuth}}

### Update linked garage
PUT {{baseUrl}}/garages/{{garageId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{garageId}},
  "capacity": 3,
  "character": { "id": {{characterId}} }
}

### Create vehicle
POST {{baseUrl}}/vehicles
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "garage": { "id": {{garageId}} },
  "type": "CAR",
  "model": "Sedan",
  "plateNumber": "HTTP-{{unique}}"
}

> {%
client.global.set("vehicleId", response.body.id);
%}

### List vehicles
GET {{baseUrl}}/vehicles
Authorization: {{userAuth}}

### Get created vehicle
GET {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: {{userAuth}}

### Update created vehicle
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{vehicleId}},
  "garage": { "id": {{garageId}} },
  "type": "TRUCK",
  "model": "Pickup",
  "plateNumber": "HTTP-UP-{{unique}}"
}

### Create gang affiliation
POST {{baseUrl}}/gang-affiliations
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "character": { "id": {{characterId}} },
  "gang": { "id": {{gangId}} },
  "joinDate": "2026-04-27"
}

> {%
client.global.set("gangAffiliationId", response.body.id);
%}

### List gang affiliations
GET {{baseUrl}}/gang-affiliations
Authorization: {{userAuth}}

### Get created gang affiliation
GET {{baseUrl}}/gang-affiliations/{{gangAffiliationId}}
Authorization: {{userAuth}}

### Update created gang affiliation
PUT {{baseUrl}}/gang-affiliations/{{gangAffiliationId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{gangAffiliationId}},
  "character": { "id": {{characterId}} },
  "gang": { "id": {{gangId}} },
  "joinDate": "2026-04-28"
}

### Create character-drug link
POST {{baseUrl}}/character-drug
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "character": { "id": {{characterId}} },
  "drug": { "id": {{drugId}} },
  "quantity": 1
}

> {%
client.global.set("characterDrugId", response.body.id);
%}

### List character-drug links
GET {{baseUrl}}/character-drug
Authorization: {{userAuth}}

### Get created character-drug link
GET {{baseUrl}}/character-drug/{{characterDrugId}}
Authorization: {{userAuth}}

### Update created character-drug link
PUT {{baseUrl}}/character-drug/{{characterDrugId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{characterDrugId}},
  "character": { "id": {{characterId}} },
  "drug": { "id": {{drugId}} },
  "quantity": 2
}

### Create character-quest link
POST {{baseUrl}}/character-quest
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "character": { "id": {{characterId}} },
  "quest": { "id": {{questId}} },
  "status": "ACCEPTED",
  "acceptedAt": "2026-04-27T10:00:00"
}

> {%
client.global.set("characterQuestId", response.body.id);
%}

### List character-quest links
GET {{baseUrl}}/character-quest
Authorization: {{userAuth}}

### Get created character-quest link
GET {{baseUrl}}/character-quest/{{characterQuestId}}
Authorization: {{userAuth}}

### Update created character-quest link
PUT {{baseUrl}}/character-quest/{{characterQuestId}}
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "id": {{characterQuestId}},
  "character": { "id": {{characterId}} },
  "quest": { "id": {{questId}} },
  "status": "IN_PROGRESS",
  "acceptedAt": "2026-04-28T10:00:00"
}

### Delete created character-quest link
DELETE {{baseUrl}}/character-quest/{{characterQuestId}}
Authorization: {{userAuth}}

### Delete created character-drug link
DELETE {{baseUrl}}/character-drug/{{characterDrugId}}
Authorization: {{userAuth}}

### Delete created gang affiliation
DELETE {{baseUrl}}/gang-affiliations/{{gangAffiliationId}}
Authorization: {{userAuth}}

### Delete created vehicle
DELETE {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: {{userAuth}}

### Delete created gang
DELETE {{baseUrl}}/gangs/{{gangId}}
Authorization: {{userAuth}}

### Delete created drug
DELETE {{baseUrl}}/drugs/{{drugId}}
Authorization: {{adminAuth}}

### Delete created quest
DELETE {{baseUrl}}/quests/{{questId}}
Authorization: {{adminAuth}}
