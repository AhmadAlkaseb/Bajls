@baseUrl = http://localhost:7070/api
@contentType = application/json
@adminAuth = Basic YWFuZGVyc2VuOlBAc3NBc3RhNQ==
@userAuth = Basic bWloYW5zZW46UEBzc01pYTE=
@unique = {{$timestamp}}

# PostgreSQL smoke requests.
# In Main.java, set DATABASE_TYPE = DatabaseType.POSTGRES.

### Admin login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "username": "aandersen",
  "password": "P@ssAsta5"
}

### Register profile
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "firstName": "Route",
  "lastName": "Tester",
  "email": "route.tester.{{unique}}@example.com",
  "username": "routeuser{{unique}}",
  "password": "RoutePass123!",
  "role": "USER"
}

### List profiles
GET {{baseUrl}}/profiles
Authorization: {{adminAuth}}

### List drugs
GET {{baseUrl}}/drugs
Authorization: {{adminAuth}}

### Create drug
POST {{baseUrl}}/drugs
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "name": "Route Dust {{unique}}",
  "type": "METH"
}

### List quests
GET {{baseUrl}}/quests
Authorization: {{adminAuth}}

### Create quest
POST {{baseUrl}}/quests
Authorization: {{adminAuth}}
Content-Type: {{contentType}}

{
  "title": "HTTP Route Quest {{unique}}",
  "description": "Quest used for route verification.",
  "reward": 777.77
}

### List characters
GET {{baseUrl}}/characters
Authorization: {{userAuth}}

### Create character
POST {{baseUrl}}/characters
Authorization: {{userAuth}}
Content-Type: {{contentType}}

{
  "name": "HttpRider {{unique}}",
  "balance": 1500.50,
  "profile": { "id": 1 },
  "gender": "FEMALE",
  "skincolor": "LIGHT",
  "eyecolor": "GREEN",
  "height": "AVERAGE",
  "weight": "LIGHT",
  "house": {
    "amountRooms": 2,
    "amountBathrooms": 1
  },
  "garage": {
    "capacity": 2
  }
}

### List gangs
GET {{baseUrl}}/gangs
Authorization: {{userAuth}}
