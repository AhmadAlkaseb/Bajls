@startuml
left to right direction
skinparam componentStyle rectangle

actor "API Client" as Client
node "Cloud Runtime" {
  component "Java REST API\nJavalin + Hibernate" as App
}
database "PostgreSQL\nRelational source" as Pg
database "MongoDB\nDocument target" as Mongo
database "Neo4j\nGraph target" as Neo
cloud "Persistent cloud storage" as Storage

Client --> App : HTTPS / REST
App --> Pg : JDBC
App --> Mongo : MongoDB driver
App --> Neo : Neo4j driver
Pg --> Storage
Mongo --> Storage
Neo --> Storage
@enduml
