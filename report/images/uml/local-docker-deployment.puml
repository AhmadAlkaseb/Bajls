@startuml
left to right direction
skinparam componentStyle rectangle

node "Developer machine" {
  component "Java app\nIDE or Maven" as App
  node "docker-compose" {
    database "db\nPostgreSQL" as Pg
    database "mongodb" as Mongo
    database "neo4j" as Neo
    component "pgAdmin" as PgAdmin
  }
}

App --> Pg : localhost:5432
App --> Mongo : localhost:27017
App --> Neo : localhost:7687
PgAdmin --> Pg : db:5432
@enduml
